# Notes. Without TURSO_DATABASE_URL, a local SQLite file (.data/notes.db) is used: fine on your machine,
# but a serverless host like Vercel needs Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Writing at /write. One password; SESSION_SECRET signs the sign-in cookie (any long random string).
WRITE_PASSWORD=
SESSION_SECRET=

# Photos and video for notes: a Cloudflare R2 bucket with public access (an r2.dev URL or your own domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
